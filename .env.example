# --- Backend (env vars override appsettings.json) ---
# ASP.NET Core maps nested config via double underscore: Section__Key
CONNECTIONSTRINGS__DEFAULT=
JWT__KEY=
JWT__ISSUER=
JWT__AUDIENCE=
HEIMDALL__BASEURL=
HEIMDALL__SERVICEID=
ASPNETCORE_ENVIRONMENT=

# --- Frontend ---
# Vite dev server port (docker-compose uses FRONTEND_PORT for nginx)
VITE_PORT=5026
# Backend URL for Vite dev proxy (uses nginx proxy in production)
VITE_API_PROXY_TARGET=http://localhost:5000
# If the API runs on a different origin in production, set this at BUILD time:
# VITE_API_BASE_URL=https://api.example.com

